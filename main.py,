
#Pydroid run kivy

from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.core.window import Window

Window.clearcolor = (0.05, 0.05, 0.08, 1)


class MisterApp(App):

    def build(self):
        layout = BoxLayout(
            orientation="vertical",
            padding=30,
            spacing=20
        )

        titulo = Label(
            text="MISTER",
            font_size=40
        )

        self.status = Label(
            text="Assistente pronto.",
            font_size=22
        )

        botao = Button(
            text="🎙️ FALAR COM O MISTER",
            font_size=20
        )

        botao.bind(on_press=self.responder)

        layout.add_widget(titulo)
        layout.add_widget(self.status)
        layout.add_widget(botao)

        return layout

    def responder(self, instance):
        self.status.text = "Mister: Estou pronto para conversar!"


MisterApp().run()
